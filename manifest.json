{
   "manifest_version": 3,
     "content_scripts": [ {
      "css": [ "content_scripts.css" ],
      "js": [ "main.js" ],
      "matches": [ "https://student.alcnaplus.jp/*" ],
      "run_at": "document_start",
      "world": "MAIN"  
   },{
      "js": [ "preventer.js" ],
      "matches": [ "https://student.alcnaplus.jp/*" ],
      "run_at": "document_start",
      "world": "ISOLATED"  
   } ],
   "description": "ALCのe-Learningを半自動化します。",
   "icons": {
      "128": "icon_128.png",
      "32": "icon_32.png",
      "48": "icon_48.png"
   },   
   
   "name": "ALC e-Learning Killer",
  "permissions": [
    "declarativeNetRequest"
  ],
    "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
   "options_page": "options.html",
   "host_permissions": [ "https://student.alcnaplus.jp/*" ],
   "short_name": "e-Learning KILLER",
   "version": "2.0.0.1"
}
